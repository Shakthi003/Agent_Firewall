# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM (Gemini free tier) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_MAX_RETRIES=5
LLM_BACKOFF_SECONDS=2

# --- Database (PostgreSQL) ---
POSTGRES_USER=agentfirewall
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agentfirewall
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Gateway ---
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
GATEWAY_URL=http://127.0.0.1:8080/mcp
GATEWAY_CALL_TIMEOUT_SECONDS=30
POLICY_DIR=policies
APPROVAL_EXPIRY_MINUTES=15
RATE_LIMIT_CALLS_PER_MINUTE=30
RATE_LIMIT_BURST=10

# --- Agent identity (keys are created by: uv run python -m scripts.register_agents) ---
AGENT_KEY_TTL_DAYS=90
FINANCE_AGENT_KEY=
IT_OPS_AGENT_KEY=
DEVELOPER_AGENT_KEY=

# --- Downstream MCP servers (internal network only) ---
COMPANY_DATA_MCP_URL=http://company-data:9001/mcp
OPERATIONS_MCP_URL=http://operations:9002/mcp
DEVELOPER_TOOLS_MCP_URL=http://developer-tools:9003/mcp

# --- Admin API / approver login ---
API_HOST=127.0.0.1
API_PORT=8000
APPROVER_USERNAME=approver
APPROVER_PASSWORD=change-me

# --- Audit ---
AUDIT_HASH_ALGORITHM=sha256
